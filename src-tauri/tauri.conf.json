{

  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Locally",
  "version": "0.1.0",
  "identifier": "com.locally.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "locally",
        "width": 1200,
        "height": 700,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true
        
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/Locally32x32.ico",
      "icons/Locally128x128.ico",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }

  
  
}

