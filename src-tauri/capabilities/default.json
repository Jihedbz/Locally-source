{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-message", 
    "dialog:default",
    "fs:allow-app-write",
    "fs:allow-app-read",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-remove",
    "fs:scope-appdata",
    "shell:allow-open", 
    "shell:default",
    "shell:allow-spawn",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "exec-code",
          "cmd": "code.exe"
        },
        {
          "name": "cmd",
          "cmd": "cmd",
          "args": true
        },
        {
          "name": "exec-powershell",
          "cmd": "powershell.exe",
          "args": true
        },
        {
          "name": "exec-sh",
          "cmd": "sh",
          "args": [
            "-c",
            {
              "validator": "\\S+"
            }
          ]
        }
        
      ]
    },
    
    {
      "identifier": "fs:scope",
      "allow": [
      "$APPDATA/projects",
      "$APPDATA/projects/*"
    ]
    }
  ]
}
